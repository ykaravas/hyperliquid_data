# Snowflake connection - copy to .env and fill in. See README, 'Snowflake authentication'.
SNOWFLAKE_ACCOUNT=ua97033.us-east-1
SNOWFLAKE_USER=first.last@soliduslabs.com
# Read-only role for all extraction tooling (the default when unset).
SNOWFLAKE_ROLE=DEV_READER
SNOWFLAKE_WAREHOUSE=DEFI_INVESTIGATIONS_MANUAL
SNOWFLAKE_DATABASE=ALLIUM_HYPERLIQUID
SNOWFLAKE_SCHEMA=DEX

# Fallback until your key is registered: Okta SSO login. Opens a browser once per process; the id token is cached in the
# keychain because requirements.txt installs the connector's secure-local-storage extra.
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Target: key-pair auth. Uncomment once a Snowflake admin has registered your public key
# (README shows how to generate the pair); it then takes precedence over the browser login.
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_rsa_key.p8
# Only for an encrypted private key.
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Password auth is the last fallback and is not used with SSO or key-pair auth.
# SNOWFLAKE_PASSWORD=
